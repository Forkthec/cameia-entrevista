    {
      "name": "Catálogo de personalización",
      "item": [
        {
          "name": "200 catálogo completo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const esperado = {\"modes\":[{\"value\":\"SIMULACION\",\"available\":true},{\"value\":\"ENTRENO\",\"available\":false}],\"tones\":[{\"value\":\"PROFESIONAL_NEUTRO\",\"available\":true},{\"value\":\"CALIDO\",\"available\":true},{\"value\":\"ESTRICTO\",\"available\":true},{\"value\":\"MOTIVADOR\",\"available\":true}],\"answerFormats\":[{\"value\":\"AUDIO\",\"available\":true},{\"value\":\"TEXTO\",\"available\":true}],\"languages\":[{\"value\":\"es-CO\",\"available\":true},{\"value\":\"en\",\"available\":true}]};",
                  "pm.test('Estado 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type JSON con charset UTF-8', () => {",
                  "    const tipo = (pm.response.headers.get('Content-Type') || '').toLowerCase();",
                  "    pm.expect(tipo).to.include('application/json');",
                  "    pm.expect(tipo).to.include('charset=utf-8');",
                  "});",
                  "pm.test('Cuerpo igual al catálogo', () => pm.expect(pm.response.json()).to.eql(esperado));",
                  "pm.test('Orden y formato exactos', () => pm.expect(pm.response.text()).to.eql(JSON.stringify(esperado)));",
                  "pm.test('ENTRENO no disponible', () => pm.expect(pm.response.json().modes[1].available).to.eql(false));",
                  "pm.test('AUDIO y TEXTO disponibles', () => {",
                  "    const formas = pm.response.json().answerFormats;",
                  "    pm.expect(formas.map(f => f.value + ':' + f.available)).to.eql(['AUDIO:true', 'TEXTO:true']);",
                  "});",
                  "pm.test('X-Request-Id devuelto igual', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.eql('postman-cat-1'));",
                  "pm.test('Responde en menos de 200 ms', () => pm.expect(pm.response.responseTime).to.be.below(200));",
                  "pm.collectionVariables.set('catalogBody', pm.response.text());"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "uid-postman-a"
              },
              {
                "key": "X-Request-Id",
                "value": "postman-cat-1"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/interviews/config/catalog",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "interviews",
                "config",
                "catalog"
              ]
            }
          }
        },
