    {
      "name": "Réplica del perfil (RabbitMQ)",
      "description": "Comprueba contra la API de administración del broker local (docker compose --profile mensajeria) la topología del consumidor de perfil.profesional-actualizado y un mensaje válido y uno inválido. Usuario guest/guest del broker local de desarrollo, no es un secreto. La fila en la base la comprueban las pruebas automáticas.",
      "auth": {
        "type": "basic",
        "basic": [
          {
            "key": "username",
            "value": "guest",
            "type": "string"
          },
          {
            "key": "password",
            "value": "guest",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "200 cola con sus argumentos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 200', () => pm.response.to.have.status(200));",
                  "const cola = pm.response.json();",
                  "pm.test('Cola durable', () => pm.expect(cola.durable).to.eql(true));",
