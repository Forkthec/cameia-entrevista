  "item": [
    {
      "name": "0 · Preparación",
      "item": [
        {
          "name": "Reiniciar escenarios de Voz",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{vozUrl}}/__admin/scenarios/reset"
          }
        },
        {
          "name": "Vaciar el registro de llamadas a Voz",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{vozUrl}}/__admin/requests"
          }
        },
        {
          "name": "Estado: pregunta 1 pendiente (guarda turn1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 200', () => pm.response.to.have.status(200));",
                  "const s = pm.response.json();",
                  "pm.test('EN_CURSO y pregunta 1', () => { pm.expect(s.status).to.eql('EN_CURSO'); pm.expect(s.pendingQuestion.number).to.eql(1); });",
                  "pm.collectionVariables.set('turn1', s.pendingQuestion.turnId);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{uid}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/interviews/sessions/{{sessionId}}/state"
          }
        }
      ]
    },
