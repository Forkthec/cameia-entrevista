{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cameia:eventos:perfil-profesional-actualizado:v1",
  "title": "perfil.profesional-actualizado v1",
  "description": "Copia del Perfil Profesional activo que Perfil publica cada vez que el perfil queda guardado en estado COMPLETED. No lleva embedding: lo calcula Entrevista. Los opcionales viajan como null, nunca se omiten.",
  "type": "object",
  "additionalProperties": false,
  "required": ["usuarioId", "contextoProfesional", "rolesAspirados", "actualizadoEn"],
  "properties": {
    "usuarioId": {
      "description": "firebaseUid del dueño del perfil, la identidad que todos los servicios reciben en X-User-Id.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "contextoProfesional": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nombre", "estado", "fecha_archivado", "resumen", "experiencias", "formaciones", "habilidades"],
      "properties": {
        "id": { "description": "Identificador del perfil.", "type": "string", "format": "uuid" },
        "nombre": { "type": "string", "minLength": 1, "maxLength": 255 },
        "estado": { "enum": ["PENDING", "IN_PROGRESS", "IN_REVIEW", "COMPLETED"] },
        "fecha_archivado": {
          "description": "Siempre null mientras el archivado de perfiles no exista.",
          "type": ["string", "null"],
          "format": "date-time"
        },
        "resumen": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "experiencias": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["empresa", "cargo", "descripcion", "inicio", "fin", "estadoEmpleo"],
            "properties": {
              "empresa": { "type": "string", "minLength": 1, "maxLength": 100 },
              "cargo": { "type": "string", "minLength": 1, "maxLength": 100 },
              "descripcion": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 },
              "inicio": { "type": ["string", "null"], "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
              "fin": { "type": ["string", "null"], "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
              "estadoEmpleo": { "enum": ["CURRENT", "UNKNOWN_END", "ENDED"] }
            }
          }
        },
        "formaciones": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["institucion", "titulo", "nivel", "inicio", "fin", "enCurso"],
            "properties": {
              "institucion": { "type": "string", "minLength": 1, "maxLength": 150 },
              "titulo": { "type": "string", "minLength": 1, "maxLength": 150 },
              "nivel": { "enum": ["TECHNICAL", "UNDERGRADUATE", "POSTGRADUATE"] },
              "inicio": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
              "fin": { "type": ["string", "null"], "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
              "enCurso": { "type": "boolean" }
            }
          }
        },
        "habilidades": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nombre", "nivel"],
            "properties": {
              "nombre": { "type": "string", "minLength": 1, "maxLength": 60 },
              "nivel": { "enum": ["BASIC", "INTERMEDIATE", "ADVANCED"] }
            }
          }
        }
      }
    },
    "rolesAspirados": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["codigo", "nombre"],
        "properties": {
          "codigo": { "description": "Identificador del rol en el catálogo de roles profesionales de Perfil.", "type": "string", "format": "uuid" },
          "nombre": { "type": "string", "minLength": 1, "maxLength": 255 }
        }
      }
    },
    "actualizadoEn": {
      "description": "Instante del cambio en UTC con milisegundos. Entrevista descarta lo que sea anterior a su copia.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  },
  "examples": [
    {
      "usuarioId": "6f1d2c3b4a5e4f60718293a4b5c6d7e8",
      "contextoProfesional": {
        "id": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
        "nombre": "Analista de datos",
        "estado": "COMPLETED",
        "fecha_archivado": null,
        "resumen": "Analista con tres años de experiencia en SQL y Python.",
        "experiencias": [
          { "empresa": "ACME", "cargo": "Analista", "descripcion": null, "inicio": "2022-01", "fin": null, "estadoEmpleo": "CURRENT" }
        ],
        "formaciones": [
          { "institucion": "Universidad del Cauca", "titulo": "Ingeniería de Sistemas", "nivel": "UNDERGRADUATE", "inicio": "2017-02", "fin": "2021-12", "enCurso": false }
        ],
        "habilidades": [ { "nombre": "Python", "nivel": "INTERMEDIATE" } ]
      },
      "rolesAspirados": [ { "codigo": "a0000001-0000-0000-0000-000000000002", "nombre": "Desarrollador Backend" } ],
      "actualizadoEn": "2026-10-15T12:00:00.123Z"
    }
  ]
}
