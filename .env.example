# =============================================================================
# Variables de entorno de cameia-entrevista
# =============================================================================
# Copia este archivo como `.env` en la raiz del repositorio y reemplaza los
# valores de ejemplo. El archivo `.env` esta en .gitignore: nunca se sube a Git
# ni se copia dentro de la imagen Docker (ver .dockerignore).
#
# Quien lee este archivo:
#   - Spring Boot, via `spring.config.import=optional:file:.env[.properties]`,
#     cuando el microservicio se ejecuta fuera de Docker.
#   - Docker Compose, que interpola estas variables al levantar los servicios.
#
# REGLA DE FORMATO: no escribas comentarios en la misma linea que un valor.
# Spring lee este archivo como `.properties` y el `#` no separa comentarios ahi:
# `DB_PORT=5432 # nota` produce el valor literal "5432 # nota" y rompe la
# conexion a la base. Los comentarios van siempre en su propia linea.
# =============================================================================


# -----------------------------------------------------------------------------
# Aplicacion
# -----------------------------------------------------------------------------

# Puerto HTTP del microservicio.
# Sin Docker: puerto en el que arranca Spring Boot en tu maquina.
# Con Docker: puerto del host que Compose publica hacia el 8080 del contenedor.
# Reparto de puertos en local: 8080 gateway, 8081 cuentas, 8082 perfil, 8083
# entrevista. El gateway enruta a este servicio por CAMEIA_ENTREVISTA_URL, que
# apunta al 8083; cambiar este valor rompe ese enrutamiento.
# En Cloud Run manda PORT, que tiene prioridad sobre esta variable.
SERVER_PORT=8083

# Perfil de Spring activo. Opcional; si se omite, Compose usa `local`.
#   local      -> Flyway instala el esquema y muestra SQL.
#   production -> Flyway instala el esquema y no muestra SQL.
# Usa `local` para desarrollo.
SPRING_PROFILE=local

# Interruptor de la documentacion de la API (OpenAPI y Swagger UI). Opcional.
# Publica o retira a la vez `/v3/api-docs` y `/swagger-ui.html`; no se sirve uno
# sin el otro, porque el JSON ya expone el contrato completo.
# Si no lo defines, decide el perfil activo:
#   local      -> documentacion publicada.
#   production -> documentacion retirada; ambas rutas responden 404.
# Definelo solo para invertir ese valor de forma temporal y deliberada.
# Aviso: con Docker Compose este valor no llega al contenedor, porque el compose
# no lo declara; ahi manda el perfil. Fuera de Docker, Spring lo lee de este archivo.
API_DOCS_ENABLED=true


# Opciones de la JVM del contenedor. Opcional; por defecto vacio.
# Ejemplo para limitar memoria: -XX:MaxRAMPercentage=75 -Xss512k
JAVA_OPTS=


# -----------------------------------------------------------------------------
# Base de datos PostgreSQL
# -----------------------------------------------------------------------------
# Entrevista usa base y rol propios, sin compartirlos con otros microservicios.

# Host de la base, usado solo cuando ejecutas el microservicio fuera de Docker.
# Con Docker, Compose ignora este valor y fuerza el nombre del servicio
# `entrevista-db`, que es como se resuelve la base dentro de la red interna.
DB_HOST=localhost

# Puerto de la base para ejecucion sin Docker.
# 5432 es el puerto por defecto de una instalacion local de PostgreSQL.
DB_PORT=5432

# Puerto del host que Compose publica hacia el 5432 del contenedor de PostgreSQL.
# Se usa 5433 para no chocar con una instalacion local que ya ocupe el 5432.
# Solo sirve para conectarte desde tu maquina (psql, DBeaver, IntelliJ).
DB_PORT_DOCKER=5433

# Nombre de la base de datos. Debe ser exclusivo de este microservicio.
DB_NAME=DB-entrevista

# Rol de PostgreSQL con el que se conecta el microservicio.
# En desarrollo suele ser `postgres`. En despliegue debe ser un rol propio de
# Entrevista, con permisos solo sobre su base.
DB_USERNAME=postgres

# Contrasena del rol anterior.
# Sin Docker: la contrasena de tu PostgreSQL local.
# Con Docker: Compose crea el contenedor de la base con esta contrasena.
# Nunca la subas a Git ni la escribas en el docker-compose.yml.
DB_PASSWORD=replace-with-your-local-password


# -----------------------------------------------------------------------------
# Proveedor LLM: Google Gemini (Spring AI)
# -----------------------------------------------------------------------------

# Clave de API de Google GenAI, usada por `cameia.llm.api-key`.
# Se obtiene en Google AI Studio (https://aistudio.google.com/apikey).
# Es un secreto: en despliegue va en el gestor de secretos, nunca en Git.
# El servicio no arranca sin ella, salvo con el perfil `local`, que trae una
# llave falsa: arranca, pero toda llamada al modelo falla con LLM_UNAVAILABLE.
# Con Docker Compose es obligatoria: sin valor, el servicio no levanta.
GOOGLE_GENAI_API_KEY=replace-with-your-google-genai-api-key

# Id del modelo de Gemini en la API, usado por `cameia.llm.model`. Obligatorio:
# sin el, el servicio no arranca en ningun perfil. Es el mismo valor de staging.
LLM_MODEL=gemini-3.5-flash-lite

# Tiempo maximo de espera de cada llamada al modelo, usado por
# `cameia.llm.timeout`. Opcional; por defecto 20000ms. Acepta duraciones de Spring
# (30s, 500ms, PT30S) y debe ser mayor que cero. La llamada no se reintenta.
LLM_TIMEOUT=20000ms

# -----------------------------------------------------------------------------
# Mensajeria (RabbitMQ)
# -----------------------------------------------------------------------------

# Direccion del broker, la que lee Spring AMQP. Broker local de desarrollo
# (`docker compose --profile mensajeria up -d`); `guest` es el usuario por defecto
# de la imagen y no es un secreto. En despliegue llega desde el gestor de secretos.
SPRING_RABBITMQ_ADDRESSES=amqp://guest:guest@localhost:5673

# -----------------------------------------------------------------------------
# Transcripcion de la respuesta por voz: AssemblyAI (CM-349, HU-5.12)
# -----------------------------------------------------------------------------

# Llave de la API de AssemblyAI (https://www.assemblyai.com/dashboard). Es un secreto: en despliegue va en el
# gestor de secretos. Opcional para arrancar: sin ella el servicio arranca, avisa en el log y cada respuesta por
# voz responde 503 TRANSCRIPTION_UNAVAILABLE.
ASSEMBLYAI_API_KEY=replace-with-your-assemblyai-api-key

# URL base de la API. Opcional; por defecto la de EE. UU. La de la UE es https://api.eu.assemblyai.com
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com

# Modelos de transcripcion en orden de preferencia, separados por coma. Opcional.
ASSEMBLYAI_SPEECH_MODELS=universal-3-5-pro,universal-2

# Tiempo maximo de cada intento de transcripcion (subida, encolado y espera). Opcional; por defecto 60s
# (CA-5.13.3: un intento que lo agota no se reintenta). Para probar el caso sin esperar un minuto, 5s.
TRANSCRIPTION_TIMEOUT=60s

# Pausa antes del reintento automatico tras un 503 o una conexion rechazada (HU-5.13). Opcional; por defecto 1s.
TRANSCRIPTION_RETRY_PAUSE=1s

# Tiempo maximo de todos los intentos de un envio. Opcional; por defecto 110s, por debajo de los 120 s del
# Gateway (GATEWAY_INTERVIEWS_TIMEOUT_MS): si el reintento no cabe, no se hace.
TRANSCRIPTION_TOTAL_BUDGET=110s

# Espera entre dos consultas del estado de la transcripcion. Opcional; por defecto 1s.
TRANSCRIPTION_POLL_INTERVAL=1s

# Confianza minima (0 a 1) para rechazar un audio en un idioma distinto al de la entrevista (CA-5.12.10).
# Opcional; por defecto 0.8.
TRANSCRIPTION_LANGUAGE_CONFIDENCE_THRESHOLD=0.8

# El audio de una respuesta por voz admite hasta 10 MiB, WebM con Opus o MP4 con AAC y de 1,5 s a 3 minutos;
# esos limites son de HU-5.8 y no se configuran.
