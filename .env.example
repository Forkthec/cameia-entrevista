# =============================================================================
# Variables de entorno de cameia-entrevista
# =============================================================================
# Copia este archivo como `.env` en la raiz del repositorio y reemplaza los
# valores de ejemplo. El archivo `.env` esta en .gitignore: nunca se sube a Git
# ni se copia dentro de la imagen Docker (ver .dockerignore).
#
# Quien lee este archivo:
#   - Spring Boot, via `spring.config.import=optional:file:.env[.properties]`,
#     cuando el microservicio se ejecuta fuera de Docker.
#   - Docker Compose, que interpola estas variables al levantar los servicios.
#
# REGLA DE FORMATO: no escribas comentarios en la misma linea que un valor.
# Spring lee este archivo como `.properties` y el `#` no separa comentarios ahi:
# `DB_PORT=5432 # nota` produce el valor literal "5432 # nota" y rompe la
# conexion a la base. Los comentarios van siempre en su propia linea.
# =============================================================================


# -----------------------------------------------------------------------------
# Aplicacion
# -----------------------------------------------------------------------------

# Puerto HTTP del microservicio.
# Sin Docker: puerto en el que arranca Spring Boot en tu maquina.
# Con Docker: puerto del host que Compose publica hacia el 8080 del contenedor.
# Se reserva 8080 para el API Gateway, por eso Entrevista usa 8081.
SERVER_PORT=8081

# Perfil de Spring activo. Opcional; si se omite, Compose usa `local`.
#   local      -> ddl-auto=create, recrea el esquema en cada arranque y muestra SQL.
#   production -> ddl-auto=validate, exige que el esquema ya exista y no muestra SQL.
# Usa `local` para desarrollo. `production` contra una base vacia falla al arrancar.
SPRING_PROFILE=local

# Interruptor de la documentacion de la API (OpenAPI y Swagger UI). Opcional.
# Publica o retira a la vez `/v3/api-docs` y `/swagger-ui.html`; no se sirve uno
# sin el otro, porque el JSON ya expone el contrato completo.
# Si no lo defines, decide el perfil activo:
#   local      -> documentacion publicada.
#   production -> documentacion retirada; ambas rutas responden 404.
# Definelo solo para invertir ese valor de forma temporal y deliberada.
# Aviso: con Docker Compose este valor no llega al contenedor, porque el compose
# no lo declara; ahi manda el perfil. Fuera de Docker, Spring lo lee de este archivo.
API_DOCS_ENABLED=true


# Opciones de la JVM del contenedor. Opcional; por defecto vacio.
# Ejemplo para limitar memoria: -XX:MaxRAMPercentage=75 -Xss512k
JAVA_OPTS=


# -----------------------------------------------------------------------------
# Base de datos PostgreSQL
# -----------------------------------------------------------------------------
# Entrevista usa base y rol propios, sin compartirlos con otros microservicios.

# Host de la base, usado solo cuando ejecutas el microservicio fuera de Docker.
# Con Docker, Compose ignora este valor y fuerza el nombre del servicio
# `entrevista-db`, que es como se resuelve la base dentro de la red interna.
DB_HOST=localhost

# Puerto de la base para ejecucion sin Docker.
# 5432 es el puerto por defecto de una instalacion local de PostgreSQL.
DB_PORT=5432

# Puerto del host que Compose publica hacia el 5432 del contenedor de PostgreSQL.
# Se usa 5433 para no chocar con una instalacion local que ya ocupe el 5432.
# Solo sirve para conectarte desde tu maquina (psql, DBeaver, IntelliJ).
DB_PORT_DOCKER=5433

# Nombre de la base de datos. Debe ser exclusivo de este microservicio.
DB_NAME=DB-entrevista

# Rol de PostgreSQL con el que se conecta el microservicio.
# En desarrollo suele ser `postgres`. En despliegue debe ser un rol propio de
# Entrevista, con permisos solo sobre su base.
DB_USERNAME=postgres

# Contrasena del rol anterior.
# Sin Docker: la contrasena de tu PostgreSQL local.
# Con Docker: Compose crea el contenedor de la base con esta contrasena.
# Nunca la subas a Git ni la escribas en el docker-compose.yml.
DB_PASSWORD=replace-with-your-local-password


# -----------------------------------------------------------------------------
# Proveedor LLM: Google Gemini (Spring AI)
# -----------------------------------------------------------------------------

# Clave de API de Google GenAI, usada por `spring.ai.google.genai.api-key`.
# Se obtiene en Google AI Studio (https://aistudio.google.com/apikey).
# Es un secreto: en despliegue va en el gestor de secretos, nunca en Git.
# Si la dejas vacia, la aplicacion arranca pero no puede llamar al proveedor LLM.
GOOGLE_GENAI_API_KEY=replace-with-your-google-genai-api-key
